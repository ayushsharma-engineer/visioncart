# Where the FastAPI backend runs. Used server-side by the /backend/* proxy in next.config.ts.
BACKEND_URL=http://localhost:8000

# Data mode for domains the backend does not serve yet (catalog, reviews).
#   live      -> call only real endpoints; missing ones show an honest "not connected" state (DEFAULT)
#   fixtures  -> read-only sample catalog so the storefront UI can be reviewed. Never fakes
#                orders, payments, seller writes or AI. Ignored in production builds.
NEXT_PUBLIC_DATA_MODE=fixtures

# Set to "true" only to demo fixtures from a production build (e.g. a stakeholder demo).
# NEXT_PUBLIC_ALLOW_FIXTURES_IN_PRODUCTION=false

# Storefront policy shown in the UI (the backend has no settings API yet).
# NEXT_PUBLIC_CURRENCY=INR
# NEXT_PUBLIC_LOCALE=en-IN
# NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=499
# NEXT_PUBLIC_SHIPPING_FEE=49
# NEXT_PUBLIC_RETURN_DAYS=7
